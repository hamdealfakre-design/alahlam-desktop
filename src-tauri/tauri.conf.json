{
  "$schema": "https://schema.tauri.app/config/2",
  "package": {
    "productName": "ALAHLAM",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": ["deb", "appimage", "msi", "dmg"]
